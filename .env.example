# Copy this file to a gitignored local env file and fill in real values from the Discord Developer Portal.
# Every value below is a placeholder. Never commit real credentials.

# --- Server (apps/api) ---
PORT=3000
LOG_LEVEL=info
# Developer Portal > General Information > Public Key (64 hex characters). Verifies inbound requests.
DISCORD_PUBLIC_KEY=replace-with-the-64-hex-character-public-key
# Docker Compose option only: password for the container's database, and the host port it listens on.
# Not needed for a standalone or hosted Postgres.
POSTGRES_PASSWORD=replace-with-password
# POSTGRES_PORT=5432
# Postgres connection URL: a standalone local instance (e.g. 127.0.0.1:5433), the Compose container
# (localhost:5432) or a hosted one with ?sslmode=require.
# A real secret: it holds the password. Environment only, never logged or committed.
DATABASE_URL=postgresql://report_line:replace-with-password@localhost:5432/report_line
# A SEPARATE throwaway database that the tests are allowed to wipe. Must differ from DATABASE_URL.
DATABASE_URL_TEST=postgresql://report_line:replace-with-password@localhost:5432/report_line_test
# --- Dashboard sign-in (server) ---
# Signs the per-session CSRF token. A real secret: 32+ random characters, environment only. Generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional (defaults shown)
# SESSION_TTL_MS=28800000           # 8 hours, absolute
# The session cookie is Secure unless you set this to false. Do that ONLY for plain-http local development.
# SESSION_COOKIE_SECURE=true
# WEB_DIST_DIR=apps/web/dist/web/browser   # Angular build to serve from this origin; missing = API only
# TRUST_PROXY_HOPS=0                # set to 1 behind one reverse proxy (Render), so login throttling sees real IPs

# --- Seed the throwaway admin (scripts/seed-admin.ts) ---
# npm run seed-admin creates it or resets its password. Choose a throwaway password of 12+ characters.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-throwaway-password

# Optional tunables (defaults shown)
# REPLAY_WINDOW_MS=300000
# STATUS_TIMEOUT_MS=1500
# RECORD_TIMEOUT_MS=1200            # recording + status read must together fit the 3 s window (max 2800)
# DB_POOL_MAX=5
# DB_CONNECTION_TIMEOUT_MS=1000
# DB_STATEMENT_TIMEOUT_MS=1500
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000

# --- Discord application (server, worker and command registration) ---
# Developer Portal > General Information > Application ID
DISCORD_APP_ID=replace-with-application-id
# Developer Portal > Bot > Reset Token. A real secret: environment only, never logged or committed.
# The worker uses it for the channel fallback when an interaction token has expired.
DISCORD_BOT_TOKEN=replace-with-bot-token
# Optional (defaults shown)
# DISCORD_API_BASE_URL=https://discord.com/api/v10
# DISCORD_TIMEOUT_MS=5000

# --- Mirror webhook encryption (server, worker, scripts/set-mirror-webhook.ts) ---
# 32 random bytes, base64. A real secret. Generate it without printing it (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($b)
#   Add-Content .env ("WEBHOOK_ENC_KEY=" + [Convert]::ToBase64String($b))
# Losing or changing it makes every stored webhook unreadable: set them again with set-mirror-webhook.
WEBHOOK_ENC_KEY=replace-with-base64-of-32-random-bytes
# Optional: the only URL prefix accepted for a Slack webhook (default shown). Stub servers in tests change it.
# SLACK_WEBHOOK_URL_PREFIX=https://hooks.slack.com/services/
# SLACK_TIMEOUT_MS=5000

# --- Worker (optional tunables, defaults shown) ---
# WORKER_MODE=inline                # "standalone" runs only the worker, no HTTP server
# CLAIM_BATCH=5
# POLL_INTERVAL_MS=1000
# LEASE_MS=60000                    # must exceed three call timeouts
# MAX_ATTEMPTS=8
# BACKOFF_BASE_MS=500
# BACKOFF_MAX_MS=60000
# The worker has its own, looser database pool:
# WORKER_DB_POOL_MAX=3
# WORKER_DB_CONNECTION_TIMEOUT_MS=5000
# WORKER_DB_STATEMENT_TIMEOUT_MS=10000
# WORKER_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# --- Command registration only (scripts/register-commands.ts) ---
# Your test server's ID (Discord: Developer Mode on, right-click the server, Copy Server ID)
DISCORD_GUILD_ID=replace-with-test-server-id
